 return Path(p.get('Paths','ProjectRoot')),p.get('DaVinciResolve','ResolveProjectFolder',fallback='').strip(),p.getint('DaVinciResolve','StartupTimeout',fallback=180),p.getint('DaVinciResolve','AliveTimeout',fallback=900)

def nodate(name):return DATE.sub('',name,count=1).strip()
def created(p):
 try:return p.stat().st_ctime
 except OSError:return 0

def choose(candidates,query):
 candidates=sorted(candidates,key=created,reverse=True); result=[None]; root=tk.Tk(); root.title('Vyber projekt'); root.resizable(False,False)
 outer=ttk.Frame(root,padding=(20,16,20,14)); outer.pack(fill='both',expand=True); ttk.Label(outer,text=f'Pro „{query}“ jsem našel více možností:').pack(anchor='w',pady=(0,10)); frame=ttk.Frame(outer); frame.pack(fill='both',expand=True)
 tree=ttk.Treeview(frame,columns=('name','created'),show='headings',height=min(max(len(candidates),5),10),selectmode='browse'); tree.heading('name',text='Projekt',anchor='w'); tree.heading('created',text='Vytvořeno',anchor='e'); tree.column('name',width=365,anchor='w',stretch=False); tree.column('created',width=155,anchor='e',stretch=False)
 scroll=ttk.Scrollbar(frame,orient='vertical',command=tree.yview); tree.configure(yscrollcommand=scroll.set); tree.pack(side='left',fill='both',expand=True); scroll.pack(side='right',fill='y'); style=ttk.Style(root); style.configure('Project.Treeview',rowheight=29); tree.configure(style='Project.Treeview')
 for i,p in enumerate(candidates):
  stamp=datetime.fromtimestamp(created(p)).strftime('%d.%m.%Y %H:%M:%S') if created(p) else ''; tree.insert('','end',iid=str(i),values=(p.name,stamp))
 if candidates:tree.selection_set('0'); tree.focus('0'); tree.see('0')
 buttons=ttk.Frame(outer); buttons.pack(pady=(14,0))
 def ok(*_):
  sel=tree.selection(); result[0]=candidates[int(sel[0])] if sel else None; root.destroy()
 def cancel(*_):root.destroy()
 ttk.Button(buttons,text='OK',command=ok,width=13).pack(side='left',padx=6); ttk.Button(buttons,text='Cancel',command=cancel,width=13).pack(side='left',padx=6); tree.bind('<Double-1>',ok); root.bind('<Return>',ok); root.bind('<Escape>',cancel); root.protocol('WM_DELETE_WINDOW',cancel)
 root.update_idletasks(); w=root.winfo_width(); h=root.winfo_height(); root.geometry(f'{w}x{h}+{max(0,(root.winfo_screenwidth()-w)//2)}+{max(0,(root.winfo_screenheight()-h)//2)}'); tree.focus_set(); root.mainloop(); return result[0]

def ask_sync(count):
 result=[False]; root=tk.Tk(); root.title('Aktualizace projektu'); root.resizable(False,False); outer=ttk.Frame(root,padding=(24,18,24,16)); outer.pack()
 ttk.Label(outer,text=f'Nalezeno {count} nových souborů.\nChcete je do projektu doplnit?',justify='left').pack(anchor='w',pady=(0,14)); buttons=ttk.Frame(outer); buttons.pack()
 def yes(*_):result[0]=True; root.destroy()
