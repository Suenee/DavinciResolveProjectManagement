 if f:
  x=mp.ImportMedia(f); n+=len(x) if x else 0
 for c in sorted([x for x in d.iterdir() if x.is_dir()],key=lambda p:p.name.casefold()):n+=tree_import(mp,b,c,life)
 return n
def build(query,keep):
 root,folder,timeout,alive=cfg(); src=resolve_project(root,query); name=src.name; shoot=next((x for x in src.iterdir() if x.is_dir() and x.name.casefold()=='shooting'),src/'SHOOTING')
 print(f'Project folder: {name}')
