   self.stop_event.set()
   if self.thread:self.thread.join(.5)
   elapsed=int(time.time()-self.started); sys.stdout.write('\r'+' '*100+'\r'); sys.stdout.flush()
   if done:print(f'[OK] {done} ({elapsed} s)')
