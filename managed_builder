   while not self.stop_event.wait(.12):
    elapsed=int(time.time()-self.started); suffix=f'{elapsed:02d} s' if maximum is None else f'{elapsed} s / max {maximum} s'; sys.stdout.write(f'\r[{next(spin)}] {self.message}  {suffix}   '); sys.stdout.flush()
