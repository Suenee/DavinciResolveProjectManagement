def resolve_project(root,query):
 if not root.is_dir():raise RuntimeError(f'Kořenový adresář neexistuje: {root}')
 q=query.strip().casefold(); candidates=[x for x in root.iterdir() if x.is_dir()]; exact=[x for x in candidates if x.name.casefold()==q]
 if len(exact)==1:return exact[0]
 stripped=[x for x in candidates if nodate(x.name).casefold()==q]
 if len(stripped)==1:return stripped[0]
 matches=stripped if stripped else [x for x in candidates if q in nodate(x.name).casefold() or q in x.name.casefold()]
 if len(matches)==1:return matches[0]
 if len(matches)>1:
  selected=choose(matches,query)
  if selected:return selected
  raise RuntimeError('Výběr projektu byl zrušen.')
 raise RuntimeError(f'Nenalezen projekt odpovídající názvu: {query}')

def dvr():
 modules=Path(os.environ.get('PROGRAMDATA',r'C:\ProgramData'))/'Blackmagic Design'/'DaVinci Resolve'/'Support'/'Developer'/'Scripting'/'Modules'; sys.path.insert(0,str(modules)); import DaVinciResolveScript as d; return d
def connect():
 try:return dvr().scriptapp('Resolve')
 except:return None

def history_section():return 'Computer:'+os.environ.get('COMPUTERNAME','UNKNOWN')
def startup_estimate(timeout):
 p=configparser.ConfigParser(); p.read(HISTORY,encoding='utf-8'); sec=history_section()
 if p.has_option(sec,'samples'):
  try:
   samples=[float(x) for x in p.get(sec,'samples').split(',') if x.strip()]
   if samples:return max(10.0,min(float(timeout),statistics.median(samples[-9:])))
  except ValueError:pass
 return min(float(timeout),60.0)
def save_startup_sample(seconds):
 HISTORY.parent.mkdir(parents=True,exist_ok=True); p=configparser.ConfigParser(); p.read(HISTORY,encoding='utf-8'); sec=history_section()
 if not p.has_section(sec):p.add_section(sec)
 try:samples=[float(x) for x in p.get(sec,'samples',fallback='').split(',') if x.strip()]
 except ValueError:samples=[]
 samples=(samples+[round(seconds,2)])[-12:]; p.set(sec,'samples',','.join(str(x) for x in samples)); p.set(sec,'last_seconds',f'{seconds:.2f}'); p.set(sec,'estimate_seconds',f'{statistics.median(samples):.2f}'); p.set(sec,'computer_name',os.environ.get('COMPUTERNAME','UNKNOWN'))
 with HISTORY.open('w',encoding='utf-8') as f:p.write(f)
def startup_bar(elapsed,estimate,attempt):
 if elapsed>=estimate*.95:estimate=max(estimate,elapsed/0.92)
 pct=min(95,int(elapsed/estimate*100)); width=24; filled=int(width*pct/100); bar='█'*filled+'░'*(width-filled); sys.stdout.write(f'\r[{bar}] {pct:3d}%  Spouštím DaVinci Resolve...  {int(elapsed)} s  (pokus {attempt}/2)   '); sys.stdout.flush(); return estimate

def ensure(name,timeout):
 r=connect()
 if r:return r
 life=load_life()
 if life.any_resolve():raise RuntimeError('Resolve.exe běží, ale scripting API není dostupné.')
 last_error=''
 for attempt in (1,2):
  estimate=startup_estimate(timeout); start=time.time(); pid=life.start_headless(name); next_probe=0.0
  while time.time()-start<timeout:
   elapsed=time.time()-start; estimate=startup_bar(elapsed,estimate,attempt)
   if not life.pid_running(pid) and elapsed>5:
    last_error='headless proces se během startu ukončil'; break
   if elapsed>=next_probe:
    r=connect(); next_probe=elapsed+1.5
    if r:
     actual=time.time()-start; save_startup_sample(actual); sys.stdout.write('\r'+' '*120+'\r'); sys.stdout.flush(); print(f'[OK] DaVinci Resolve připraven (100 %, {actual:.1f} s)'); return r
   time.sleep(.12)
  sys.stdout.write('\r'+' '*120+'\r'); sys.stdout.flush(); life.force_stop_owned()
  if attempt==1:
   print(f'[WARN] Start Resolve se nepodařil ({last_error or "API timeout"}). Zkouším recovery...'); time.sleep(4)
 raise RuntimeError(f'Resolve se nepřihlásil k API ani po recovery (timeout {timeout} s na pokus).')

def normpath(p):return os.path.normcase(os.path.normpath(os.path.abspath(str(p))))
def direct_files(d):return [x.resolve() for x in sorted(d.iterdir(),key=lambda p:p.name.casefold()) if x.is_file()]
def all_files(d):return [x.resolve() for x in d.rglob('*') if x.is_file()]
def get_subfolders(folder):
 try:return folder.GetSubFolderList() or []
 except:return []
def folder_name(folder):
 try:return folder.GetName() or ''
 except:return ''
def get_or_create_bin(mp,parent,name):
 for sub in get_subfolders(parent):
  if folder_name(sub).casefold()==name.casefold():return sub
 b=mp.AddSubFolder(parent,name)
 if b is None:raise RuntimeError(f'Nelze vytvořit BIN {name}')
 return b
def collect_media_paths(folder,out):
 try:clips=folder.GetClipList() or []
 except:clips=[]
 for clip in clips:
  try:p=clip.GetClipProperty('File Path')
  except:p=None
  if p:out.add(normpath(p))
 for sub in get_subfolders(folder):collect_media_paths(sub,out)
def sync_tree(mp,parent,d,missing,counter,total,life):
 b=get_or_create_bin(mp,parent,d.name); mp.SetCurrentFolder(b); life.put(stage=f'Importuji {d.name}…'); selected=[p for p in direct_files(d) if normpath(p) in missing]; n=0
 if selected:
  PROGRESS.start(f'Importuji {d.name}...')
  try:x=mp.ImportMedia([str(p) for p in selected]); n+=len(x) if x else 0
  finally:PROGRESS.stop()
  counter[0]+=len(selected); PROGRESS.bar(f'Import médií: {d.name}',counter[0],total); PROGRESS.bar_done()
 for c in sorted([x for x in d.iterdir() if x.is_dir()],key=lambda p:p.name.casefold()):
  if any(normpath(p) in missing for p in all_files(c)):n+=sync_tree(mp,b,c,missing,counter,total,life)
 return n

def finish_owned(life,r,keep,alive):
 owned=life.state(); ours=owned.get('owned') and owned.get('mode')=='headless' and life.pid_running(owned.get('pid'))
 if not ours:return
 if keep=='none':
  PROGRESS.start('Ukončuji headless DaVinci Resolve...'); time.sleep(3); owned=life.state()
  if owned.get('owned') and life.pid_running(owned.get('pid')):life.stop_owned(r)
  PROGRESS.stop('Headless DaVinci Resolve ukončen')
 elif keep=='alive':life.launch_keeper(); print(f'[OK] Resolve zůstává připravený --alive (idle timeout {alive} s).')
 else:print('[OK] Resolve zůstává připravený --persistent.')

def build(query,keep):
 started_all=time.time(); root,folder,timeout,alive=cfg(); src=resolve_project(root,query); name=src.name
 shoot=next((x for x in src.iterdir() if x.is_dir() and x.name.casefold()=='shooting'),src/'SHOOTING'); print(f'Project folder: {name}')
 if not shoot.is_dir():raise RuntimeError(f'Chybí SHOOTING: {shoot}')
 media_dirs=[shoot]
 for dn in OPTIONAL:
  d=next((x for x in src.iterdir() if x.is_dir() and x.name.casefold()==dn.casefold()),None)
  if d:media_dirs.append(d)
 filesystem_files=[p for d in media_dirs for p in all_files(d)]; filesystem_norm={normpath(p):p for p in filesystem_files}
 life=load_life(); r=ensure(name,timeout); life.put(busy=True,project=name,stage='Kontroluji projekt…',keep_mode=keep,alive_timeout=alive)
 try:
  pm=r.GetProjectManager(); pm.GotoRootFolder()
  if folder and not pm.OpenFolder(folder):raise RuntimeError(f'Project Library folder nenalezen: {folder}')
  projects=pm.GetProjectListInCurrentFolder() or []; existing=next((x for x in projects if x.casefold()==name.casefold()),None)
  if existing:
   PROGRESS.start('Kontroluji existující projekt...'); pr=pm.LoadProject(existing)
   if pr is None:PROGRESS.stop(); raise RuntimeError(f'Existující projekt nelze otevřít: {existing}')
   mp=pr.GetMediaPool(); master=mp.GetRootFolder(); present=set(); collect_media_paths(master,present); missing_keys=set(filesystem_norm)-present; PROGRESS.stop('Kontrola projektu dokončena')
   if not missing_keys:
    print('[OK] Projekt je aktuální. Žádná nová média.'); return finish_owned(life,r,keep,alive)
   print(f'[INFO] Nalezeno {len(missing_keys)} nových souborů.')
   if not ask_sync(len(missing_keys)):
    print('[OK] Projekt ponechán beze změny.'); return finish_owned(life,r,keep,alive)
   counter=[0]; imported=0
   for d in media_dirs:
    if any(normpath(p) in missing_keys for p in all_files(d)):imported+=sync_tree(mp,master,d,missing_keys,counter,len(missing_keys),life)
   life.put(stage='Ukládám projekt…'); PROGRESS.start('Ukládám projekt...'); pm.SaveProject(); PROGRESS.stop('Projekt uložen'); print(f'[OK] Doplněno médií: {imported}')
  else:
   life.put(stage='Zakládám projekt…'); PROGRESS.start('Zakládám projekt...'); pr=pm.CreateProject(name); PROGRESS.stop('Projekt založen')
   if pr is None:raise RuntimeError(f'Projekt nelze založit: {name}')
   mp=pr.GetMediaPool(); master=mp.GetRootFolder(); missing_keys=set(filesystem_norm); counter=[0]; imported=0
   for d in media_dirs:imported+=sync_tree(mp,master,d,missing_keys,counter,len(missing_keys),life)
   life.put(stage='Zakládám timeline…'); PROGRESS.start('Zakládám timeline...'); tb=get_or_create_bin(mp,master,'TIMELINES'); mp.SetCurrentFolder(tb); tn=nodate(name) or name; mp.CreateEmptyTimeline(tn); PROGRESS.stop('Timeline založena'); life.put(stage='Ukládám projekt…'); PROGRESS.start('Ukládám projekt...'); pm.SaveProject(); PROGRESS.stop('Projekt uložen'); print(f'[OK] Vytvořen projekt: {name} | Timeline: {tn} | Imported media: {imported}')
  print(f'[OK] Hotovo za {int(time.time()-started_all)} s')
 finally:
  PROGRESS.stop(); life.put(busy=False,stage='Hotovo')
 finish_owned(life,r,keep,alive)

def main():
 p=argparse.ArgumentParser(); p.add_argument('project'); g=p.add_mutually_exclusive_group(); g.add_argument('--alive',action='store_true'); g.add_argument('--persistent',action='store_true'); a=p.parse_args(); keep='persistent' if a.persistent else 'alive' if a.alive else 'none'
 try:build(a.project,keep); return 0
 except Exception as e:PROGRESS.stop(); print('ERROR:',e,file=sys.stderr); return 1
if __name__=='__main__':raise SystemExit(main())
